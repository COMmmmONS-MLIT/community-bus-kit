<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="maint.mapper.TwoFactorAuthHistoriesMapper">

    <insert id="insertTwoFactorHistory" useGeneratedKeys="true" keyProperty="twoFactorAuthHistoryId">
        INSERT INTO "two_factor_auth_histories" (
            "user_id"
            ,"auth_code"
            ,"code_issue_datetime"
          <include refid="maint.mapper.CommonMapper.insertCommonItemColumns"/>
        )
        VALUES (
            #{userId}
            ,#{authCode}
            ,CURRENT_TIMESTAMP
            ,#{userId}
            ,CURRENT_TIMESTAMP
            ,#{userId}
            ,CURRENT_TIMESTAMP
            )
    </insert>

    <update id="deleteTwoFactorAuthHistoryByUserId">
        UPDATE "two_factor_auth_histories"
           SET "del_flag"               = "two_factor_auth_history_id"
        <include refid="maint.mapper.CommonMapper.updateCommon"/>
         WHERE "del_flag"               = 0
           AND "user_id"                = #{userId}
    </update>

    <select id="countValidTwoFactorAuth" resultType="java.lang.Long">
        SELECT COUNT("two_factor_auth_history_id")
          FROM "two_factor_auth_histories"
         WHERE "del_flag"             = 0
           AND "user_id"              = #{userId}
           AND "auth_code"            = #{authCode}
           AND "code_issue_datetime" &gt; CAST(#{compareDateTime} AS TIMESTAMP)
    </select>
</mapper>
